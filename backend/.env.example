NODE_ENV=development
PORT=4000
ROUTE_PREFIX=/api
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# "all" loads every module in src/modules; set a folder name to load just one
APP_MODULE=all

# MongoDB connection. The server connects at start-up and exits with an error if it can't.
# Use a mongodb+srv:// URL for Atlas, or mongodb://localhost:27017 for a local server.
DB_URL=
DB_NAME=synth-db
# Set to true to start the server without a database
SKIP_DB_CONNECTION=false
