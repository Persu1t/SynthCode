NODE_ENV=development
PORT=4000
ROUTE_PREFIX=/api
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# "all" loads every module in src/modules; set a folder name to load just one
APP_MODULE=all

# MongoDB connection
DB_URL=
DB_NAME=synth-db
SKIP_DB_CONNECTION=false

# Auth: use a cryptographically random secret (at least 32 characters) in production
AUTH_JWT_SECRET=
